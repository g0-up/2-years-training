    { "source": "/2-thang", "destination": "/index.html" },
    { "source": "/6-thang", "destination": "/index.html" },
    { "source": "/12-thang", "destination": "/index.html" },
    { "source": "/hoc-phi-530f586a", "destination": "/hoc-phi-530f586a.html" }
  ],
  "headers": [
    {
